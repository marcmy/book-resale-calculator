{
  "name": "book-resale-calculator",
  "version": "2.0.0-alpha.1",
  "description": "Desktop book resale calculator with USPS Media Mail rates and ROI math.",
  "author": "marcmy",
  "main": "electron/main.cjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "check": "node scripts/check-calculator.js",
    "update:usps": "node scripts/update-usps-media-mail-rates.js",
    "build:win": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.marcmy.bookresalecalculator",
    "productName": "Book Resale Calculator",
    "artifactName": "BookResaleCalculator-${version}-Windows-x64.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "styles.css",
      "script.js",
      "rates.js",
      "rates.json",
      "electron/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3"
  }
}
